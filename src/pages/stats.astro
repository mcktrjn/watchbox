---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { StatsView } from "@/components/statistics/StatsView";
---

<Layout title="Statistics">
  <div class="bg-cosmic min-h-screen p-4 sm:p-8">
    <Topbar />
    <div class="mx-auto max-w-3xl">
      <h1 class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
        Statistics
      </h1>
      <StatsView client:load />
    </div>
  </div>
</Layout>
